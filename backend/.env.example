# ── 数据库 ─────────────────────────────────────────────────────────────────────
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://psy_user:your_password@localhost:5432/psy_db

# ── 数据目录（与代码目录分离，防止 git pull 误删用户上传文件） ─────────────────────
# 部署时建议设为代码目录之外的路径，例如 /var/psy_website/uploads
# 不设则默认回退到 backend/uploads/（开发环境可用）
UPLOAD_DIR=/data/shenyurou/uploads

# ── HiAgent API（main.py / 正式模式） ──────────────────────────────────────────
HITSZ_API_KEY=your_hiagent_api_key
HITSZ_HOST=zhiwen.hitsz.edu.cn:10211
HITSZ_APP_ID=your_app_id
HITSZ_AK=your_access_key
HITSZ_SK=your_secret_key
HITSZ_TENANT_ID=your_tenant_id
HITSZ_DIARY_API_KEY=your_diary_api_key
HITSZ_DIARY_APP_ID=your_diary_app_id

# ── AI 引擎 LLM（main_ai.py / 演示模式） ───────────────────────────────────────
AI_LLM_PROVIDER=deepseek
AI_LLM_API_KEY=your_deepseek_api_key
AI_LLM_MODEL=deepseek-chat
AI_LLM_BASE_URL=https://api.deepseek.com

# ── HuggingFace 离线模式（WSL2 / 无公网环境必须保持为 1） ──────────────────────
# 模型需提前缓存到 ~/.cache/huggingface/，缓存后设 1 可跳过网络检查
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

[Unit]
Description=PSY Website — HiAgent Backend (main.py)
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/psy_website/backend
EnvironmentFile=/opt/psy_website/backend/.env
ExecStart=/opt/psy_website/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
